---
import { getCollection } from 'astro:content';

// Mengambil data produk dari berkas JSON otomatis saat build
const allProducts = await getCollection('products');
const productsData = allProducts || [];

const categories = [
  { id: 'all', name: 'Semua Komponen' },
  { id: 'hydraulic', name: 'Hydraulic System' },
  { id: 'pneumatic', name: 'Pneumatic Supply' },
  { id: 'services', name: 'Services & Repair' }
];
---

<section class="bg-slate-50 py-20 px-4 md:px-8">
  <div class="max-w-7xl mx-auto">
    
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 border-b border-slate-200 pb-6">
      <div>
        <span class="text-blue-600 font-bold uppercase tracking-wider text-xs px-3 py-1 bg-blue-50 rounded-md">
          Katalog Komponen Resmi
        </span>
        <h2 class="text-3xl md:text-4xl font-black text-slate-900 mt-3 tracking-tight">
          Stok Ready & Terlengkap
        </h2>
        <p class="text-slate-500 mt-2 max-w-xl text-sm">
          Sistem navigasi cepat komponen industri presisi tinggi PT Atra Web. Cari komponen Anda berdasarkan kategori kerja.
        </p>
      </div>
      
      <!-- Navigasi Filter Kategori Dinamis -->
      <div class="flex flex-wrap gap-2 mt-6 md:mt-0 bg-slate-200/60 p-1.5 rounded-xl border border-slate-200">
        {categories.map((cat, idx) => (
          <button 
            class={`filter-btn px-5 py-2.5 rounded-lg text-xs font-bold tracking-wide uppercase transition-all duration-200 ${idx === 0 ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 hover:bg-slate-200'}`}
            data-filter={cat.id}
          >
            {cat.name}
          </button>
        ))}
      </div>
    </div>

    <!-- Product Grid Map -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8" id="corporate-product-grid">
      {productsData.map((product) => (
        <div 
          class="product-card bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:border-blue-500/30 transition-all duration-300 flex flex-col group" 
          data-category={product.data.category}
        >
          <!-- Wadah Gambar dengan Rasio Presisi Korporat -->
          <div class="aspect-[4/3] bg-slate-100 relative overflow-hidden border-b border-slate-100">
            <div class="absolute inset-0 bg-slate-900/5 group-hover:bg-transparent transition duration-300 z-10"></div>
            <img 
              src={product.data.image} 
              alt={product.data.name} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              loading="lazy" 
            />
            <span class="absolute top-4 left-4 bg-slate-900/80 text-white text-[10px] font-bold tracking-widest uppercase px-3 py-1 rounded-md backdrop-blur-sm z-20">
              {product.data.category}
            </span>
          </div>
          
          <!-- Konten & Spesifikasi Teknik -->
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <h4 class="font-extrabold text-slate-800 text-lg tracking-tight group-hover:text-blue-600 transition line-clamp-2">
                {product.data.name}
              </h4>
              
              <!-- List Spek Teknikal Khas Web B2B Profesional -->
              {product.data.specification && (
                <ul class="mt-4 space-y-1.5 border-t border-slate-100 pt-4">
                  {product.data.specification.map((spec) => (
                    <li class="text-xs text-slate-500 flex items-center gap-2">
                      <span class="w-1.5 h-1.5 rounded-full bg-blue-500 block shrink-0"></span>
                      <span class="line-clamp-1">{spec}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
            
            <!-- CTA Penawaran Langsung ke WhatsApp -->
            <div class="mt-6">
              <a 
                href={product.data.ctaLink} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="block text-center bg-slate-900 hover:bg-blue-600 text-white text-xs font-bold tracking-wider uppercase py-3.5 rounded-xl shadow-sm hover:shadow-md transition-all duration-200"
              >
                Minta Penawaran Harga
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Logika Filter Client-side Berkecepatan Tinggi (Vanilla JS)
  const buttons = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.product-card');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      // Atur status aktif tombol visual
      buttons.forEach(b => {
        b.classList.remove('bg-blue-600', 'text-white', 'shadow-sm');
        b.classList.add('text-slate-600', 'hover:bg-slate-200');
      });
      btn.classList.add('bg-blue-600', 'text-white', 'shadow-sm');
      btn.classList.remove('text-slate-600', 'hover:bg-slate-200');
      
      const filter = btn.getAttribute('data-filter');
      
      // Logika penyaringan kartu produk
      cards.forEach(card => {
        const category = card.getAttribute('data-category');
        const htmlCard = card as HTMLElement;
        
        if (filter === 'all' || category === filter) {
          htmlCard.style.opacity = '1';
          htmlCard.style.transform = 'scale(1)';
          htmlCard.style.display = 'flex';
        } else {
          htmlCard.style.opacity = '0';
          htmlCard.style.transform = 'scale(0.95)';
          setTimeout(() => {
            htmlCard.style.display = 'none';
          }, 150);
        }
      });
    });
  });
</script>
