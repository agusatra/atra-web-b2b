---
import ProductCatalog from '../components/ProductCatalog.astro';
import '../styles/global.css';

// Bagian Logika & Data Proyek Atra Web - Industri Hidrolik & Pneumatik
const namaPerusahaan = "PT. PTM";
---

<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{namaPerusahaan} - Solusi B2B Hydraulic & Pneumatic</title>
    <style>
        /* Desain Utama */
        body { font-family: 'Segoe UI', Roboto, sans-serif; margin: 0; padding: 0; background: #f1f5f9; }
        
        /* GAYA MENU ATAS (NAVBAR) */
        .navbar { background: #0f172a; display: flex; justify-content: space-between; align-items: center; padding: 15px 30px; }
        .nav-logo { color: white; font-weight: 800; font-size: 1.3rem; text-decoration: none; }
        .nav-menu { display: flex; gap: 20px; list-style: none; margin: 0; padding: 0; align-items: center; }
        .nav-menu a { color: #cbd5e1; text-decoration: none; font-size: 0.95rem; font-weight: 500; transition: color 0.2s; }
        .nav-menu a:hover { color: white; }
        
        /* Link Khusus Menu ERP Staf */
        .btn-erp { background: #2563eb; color: white !important; padding: 6px 12px; border-radius: 4px; font-weight: 6px; }
        .btn-erp:hover { background: #1d4ed8; }

        .hero { text-align: center; padding: 60px 20px; background: white; border-bottom: 1px solid #e2e8f0; }
        .hero h1 { color: #0f172a; margin-0; font-size: 2.2rem; }
        .hero p { color: #64748b; font-size: 1.1rem; margin-top: 10px; }
        .main-content { max-width: 1200px; margin: 30px auto; padding: 0 20px; }
    </style>
</head>
<body>

    <!-- NAVIGASI UTAMA -->
    <nav class="navbar">
        <a href="/" class="nav-logo">{namaPerusahaan}</a>
        <ul class="nav-menu">
            <li><a href="/">Beranda</a></li>
            <li><a href="/produk">Katalog Produk</a></li>
            <li><a href="/tentang">Tentang Kami</a></li>
            <!-- Akses Pintas Menu ERP Tiga PC Staf PTM -->
            <li><a href="/marketing" class="btn-erp">💻 PC Marketing</a></li>
            <li><a href="/gudang" class="btn-erp">⚙️ PC Gudang</a></li>
            <li><a href="/admin" class="btn-erp">🧾 PC Admin</a></li>
        </ul>
    </nav>

    <!-- KONTEN HALAMAN UTAMA -->
    <header class="hero">
        <h1>Selamat Datang di Portal {namaPerusahaan}</h1>
        <p>Sistem ERP Internal & Katalog Distribusi Komponen Logam Industri</p>
    </header>

    <main class="main-content">
        <ProductCatalog />
    </main>

</body>
</html>
