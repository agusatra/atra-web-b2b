---
// src/pages/gudang.astro
import { db } from '../db';
import { orders, stockItems, products } from '../db/schema';
import { eq, sql } from 'drizzle-orm';

// Mengambil antrean pemotongan aktif
const antreanGudang = await db.select({
  orderId: orders.id,
  orderNumber: orders.orderNumber,
  requestedLength: orders.requestedLength,
  stockItemId: orders.stockItemId,
  serialNumber: stockItems.serialNumber,
  productName: products.productName,
  materialType: products.materialType,
  diameter: products.diameter,
})
.from(orders)
.leftJoin(stockItems, eq(orders.stockItemId, stockItems.id))
.leftJoin(products, eq(orders.productId, products.id))
.where(eq(orders.status, 'PROSES_POTONG_GUDANG'));

// Eksekusi ketika tombol Potong Selesai diklik oleh staf gudang
if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const orderId = parseInt(data.get('order_id') as string);
  const stockItemId = parseInt(data.get('stock_item_id') as string);
  const requestedLength = parseInt(data.get('requested_length') as string);

  // ALGORITMA OTOMATIS: Potong nilai milimeter langsung di database
  await db.update(stockItems)
    .set({
      currentLength: sql`${stockItems.currentLength} - ${requestedLength}`,
      status: 'Tersedia'
    })
    .where(eq(stockItems.id, stockItemId));

  // Update alur status dokumen agar terbaca di PC Admin
  await db.update(orders)
    .set({ status: 'VERIFIKASI_ADMIN' })
    .where(eq(orders.id, orderId));

  return Astro.redirect('/gudang?success=updated');
}
---
<html lang="id">
<head><title>PC Gudang - Eksekusi Bengkel</title></head>
<body style="font-family: Arial, sans-serif; padding: 20px; background: #fffbeb;">
  <div style="margin-bottom: 20px;"><a href="/" style="text-decoration: none; color: #b45309; font-weight: bold;">⬅ Kembali ke Beranda Portal PTM</a></div>
  <h1 style="color: #b45309;">⚙ MONITOR PC GUDANG: Antrean Pemotongan Logam</h1>

  {antreanGudang.length === 0 ? (
    <p style="font-size: 18px; color: #6b7280;">Tidak ada antrean pemotongan hari ini. Kerja bagus!</p>
  ? (
    <div style="display: grid; gap: 20px;">
      {antreanGudang.map(item => (
        <div style="background: white; border-left: 8px solid #b45309; padding: 20px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
          <h3>No. Bukti Potong: <span style="color:#b45309;">{item.orderNumber}</span></h3>
          <p><b>Ambil Dari Batang:</b> {item.serialNumber}</p>
          <p><b>Produk:</b> {item.productName} ({item.materialType} Dia {item.diameter}mm)</p>
          <p style="font-size: 20px; background: #fef3c7; padding: 10px; display: inline-block; border-radius: 4px;">
            ⚠️ <b>INSTRUKSI POTONG:</b> Ukur & Potong Sepanjang <b>{item.requestedLength} mm</b>
          </p>
          
          <form method="POST" style="margin-top: 15px;">
            <input type="hidden" name="order_id" value={item.orderId} />
            <input type="hidden" name="stock_item_id" value={item.stockItemId} />
            <input type="hidden" name="requested_length" value={item.requestedLength} />
            <button type="submit" style="padding: 12px 24px; background: #047857; color: white; border: none; font-weight: bold; cursor: pointer; border-radius: 4px;">
              ✔ Selesai Potong (Update Panjang Besi)
            </button>
          </form>
        </div>
      ))}
    </div>
  )}
</body>
</html>
