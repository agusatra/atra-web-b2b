---
export const prerender = false;

// Deklarasi mock data admin agar aman dari crash database di lokal saat build
const rekapDipotong = [
  { id: 1, produk: "Induction Hard Chrome", panjangPotong: 1500, status: "Selesai" },
  { id: 2, produk: "Induction Hard Chrome", panjangPotong: 2000, status: "Diproses" }
];
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <title>PC Admin - Solusi B2B</title>
  </head>
  <body style="font-family: Arial, sans-serif; padding: 20px; background: #f0fdf4; margin: 0;">

    <a href="/" style="display: inline-block; color: #15803d; text-decoration: none; font-weight: bold; margin-bottom: 20px;">
      ← Kembali ke Beranda Portal PTM
    </a>

    <h1 style="color: #15803d; border-bottom: 2px solid #15803d; padding-bottom: 10px; margin-top: 0;">
      🖥️ MONITOR PC ADMIN: Rekapitulasi Bukti Potong
    </h1>

    <div style="background: white; padding: 20px; border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); margin-top: 20px;">
      <h2 style="font-size: 18px; margin-top: 0; color: #1e293b;">Riwayat Log Pemotongan Batang Besi</h2>
      
      <table style="width: 100%; border-collapse: collapse; margin-top: 15px; font-size: 14px;">
        <thead>
          <tr style="background: #f1f5f9; border-bottom: 2px solid #cbd5e1;">
            <th style="padding: 10px; text-align: left;">ID Transaksi</th>
            <th style="padding: 10px; text-align: left;">Nama Produk</th>
            <th style="padding: 10px; text-align: left;">Panjang Dipotong</th>
            <th style="padding: 10px; text-align: left;">Status Gudang</th>
          </tr>
        </thead>
        <tbody>
          {rekapDipotong.map((log) => (
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 10px; font-weight: bold; color: #64748b;">TX-00{log.id}</td>
              <td style="padding: 10px; color: #334155;">{log.produk}</td>
              <td style="padding: 10px; font-weight: bold; color: #dc2626;">{log.panjangPotong} mm</td>
              <td style="padding: 10px;">
                <span style={`background: ${log.status === 'Selesai' ? '#dcfce7' : '#fef9c3'}; color: ${log.status === 'Selesai' ? '#15803d' : '#a16207'}; padding: 4px 8px; border-radius: 4px; font-weight: bold; font-size: 12px;`}>
                  {log.status}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

  </body>
</html>
